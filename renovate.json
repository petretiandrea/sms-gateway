{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": {
    "enabled": true
  },
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "timezone": "Europe/Rome",
  "schedule": [
    "before 6am on monday"
  ],
  "enabledManagers": [
    "gomod",
    "dockerfile",
    "docker-compose",
    "github-actions",
    "helmv3",
    "helm-values"
  ],
  "includePaths": [
    "go.mod",
    "tools/go.mod",
    "Dockerfile",
    "docker-compose.yaml",
    "chart/**",
    ".github/workflows/**"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": false
    },
    {
      "description": "oapi-codegen/runtime v1.9.0+ removes strictmiddleware/gin, used by internal/api/server.go",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/oapi-codegen/runtime"
      ],
      "allowedVersions": "<1.9.0"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchFileNames": [
        "go.mod"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "app Go major updates",
      "semanticCommitType": "fix",
      "semanticCommitScope": "app",
      "automerge": false
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchFileNames": [
        "go.mod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "app Go minor and patch updates",
      "semanticCommitType": "fix",
      "semanticCommitScope": "app",
      "automerge": true,
      "matchCurrentVersion": "!/^0\\./"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchFileNames": [
        "tools/go.mod"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "tools Go major updates",
      "semanticCommitType": "fix",
      "semanticCommitScope": "tools",
      "automerge": false
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchFileNames": [
        "tools/go.mod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "tools Go minor and patch updates",
      "semanticCommitType": "fix",
      "semanticCommitScope": "tools",
      "automerge": true,
      "matchCurrentVersion": "!/^0\\./"
    },
    {
      "matchManagers": [
        "dockerfile",
        "docker-compose",
        "helm-values"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "container image major updates",
      "semanticCommitType": "fix",
      "semanticCommitScope": "containers",
      "automerge": false
    },
    {
      "matchManagers": [
        "dockerfile",
        "docker-compose",
        "helm-values"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "container image minor and patch updates",
      "semanticCommitType": "fix",
      "semanticCommitScope": "containers",
      "automerge": true,
      "matchCurrentVersion": "!/^0\\./"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "CI major updates",
      "semanticCommitType": "fix",
      "semanticCommitScope": "ci",
      "automerge": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "CI minor and patch updates",
      "semanticCommitType": "fix",
      "semanticCommitScope": "ci",
      "automerge": true,
      "matchCurrentVersion": "!/^0\\./"
    }
  ]
}
