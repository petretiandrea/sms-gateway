{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Migrate up",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd",
      "cwd": "${workspaceFolder}",
      "args": [
        "migrate",
        "--database",
        "${input:postgresDsn}",
        "up"
      ],
      "env": {
        "POSTGRES_DSN": "${input:postgresDsn}"
      }
    },
    {
      "name": "Start",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd",
      "cwd": "${workspaceFolder}",
      "args": [
        "start"
      ],
      "env": {
        "ENV_POSTGRES_DSN": "postgres://sms_gateway:sms_gateway@localhost:5432/sms_gateway?sslmode=disable",
        "ENV_RABBITMQ_DSN": "amqp://sms_gateway:sms_gateway@localhost:5672/",
        "ENV_FIREBASE_CREDENTIALS__FILE": "${workspaceFolder}/be-aesthetic-admin-sdk.json"
      }
    }
  ],
  "inputs": [
    {
      "id": "postgresDsn",
      "type": "promptString",
      "description": "Postgres DSN",
      "default": "postgres://sms_gateway:sms_gateway@localhost:5432/sms_gateway?sslmode=disable"
    }
  ]
}
