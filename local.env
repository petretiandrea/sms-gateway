POSTGRES_DB=sms_gateway
POSTGRES_USER=sms_gateway
POSTGRES_PASSWORD=sms_gateway

RABBITMQ_DEFAULT_USER=sms_gateway
RABBITMQ_DEFAULT_PASS=sms_gateway
RABBITMQ_DEFAULT_VHOST=/

POSTGRES_DSN=postgres://sms_gateway:sms_gateway@postgres:5432/sms_gateway?sslmode=disable
RABBITMQ_DSN=amqp://sms_gateway:sms_gateway@rabbitmq:5672/

ENV_APP__NAME=sms-gateway
ENV_DRY__RUN=true
ENV_POSTGRES__DSN=postgres://sms_gateway:sms_gateway@postgres:5432/sms_gateway?sslmode=disable
ENV_RABBITMQ__DSN=amqp://sms_gateway:sms_gateway@rabbitmq:5672/

GIN_MODE=debug
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_EXPORTER_OTLP_COMPRESSION=gzip
